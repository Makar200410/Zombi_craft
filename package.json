{
  "name": "zombi-craft",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Voxel sandbox + village strategy + zombie waves + magic & research",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "desktop": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win --publish never"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "vite": "^8.3.1"
  },
  "main": "electron/main.cjs",
  "author": "Zombi Craft",
  "build": {
    "appId": "com.zombicraft.game",
    "productName": "Zombi Craft",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/main.cjs",
      "electron/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable",
        "zip"
      ],
      "icon": "electron/icon.png",
      "artifactName": "ZombiCraft-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "ZombiCraft-portable.exe",
      "splashImage": "electron/splash.bmp"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "ZombiCraft-Setup.exe",
      "shortcutName": "Zombi Craft",
      "runAfterFinish": true,
      "createDesktopShortcut": true
    },
    "electronLanguages": [
      "ru",
      "en-US"
    ],
    "compression": "normal"
  }
}